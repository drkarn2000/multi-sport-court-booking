{
  "name": "playcourt",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node scripts/db-cli.mjs init && next dev",
    "build": "next build",
    "start": "node scripts/db-cli.mjs init && next start",
    "db:init": "node scripts/db-cli.mjs init",
    "db:reseed": "node scripts/db-cli.mjs reseed --confirm",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test:api": "node scripts/test-local-suite.mjs",
    "test:e2e": "node scripts/e2e-browser-test.mjs",
    "test": "npm run typecheck && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1",
    "framer-motion": "^11.15.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.4",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
