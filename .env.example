# ============================================================================
# PlayCourt — Local Development Environment Configuration (.env.example)
# Copy this file to .env before starting local development:
#   Copy-Item .env.example .env
# ============================================================================

# Environment Mode ("local" enables local-only OTP inspector & safe reseed tools;
# set to "production" to strictly disable all dev OTP hints, demo resets & test helpers)
PLAYCOURT_ENV="local"

# Local SQLite Database Path (preserved across normal restarts; ignored by Git)
DATABASE_URL="file:./prisma/playcourt.db"
# Production PostgreSQL 16+ example (DO NOT use during local manual testing):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playcourt?schema=public"

# Session & JWT Signing Secret (generate a strong 32+ byte secret in production)
SESSION_SECRET="playcourt-local-dev-jwt-secret-key-change-before-prod-32b"
SESSION_COOKIE_NAME="pc_session"
APP_TIMEZONE="Asia/Kolkata"

# OTP / SMS Provider ("console" logs & displays OTP locally; "msg91" or "twilio" for prod)
SMS_PROVIDER="console"
OTP_MAX_REQUESTS_PER_WINDOW="5"
ENABLE_DEV_OTP_HINT="true"
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Payment Provider ("simulated" enables sandbox success/failure/cancel testing; never charges real money)
PAYMENT_PROVIDER="simulated"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
